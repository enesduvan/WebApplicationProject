@using WebApplicationProject.Models.Entities
@model BookCategory


<form method="post">
	<input asp-for="CategoryId" hidden/>
	<div class="border p-3 mt-5">
		<div class="row pb-3">
			<h2 class="text-primary">Kitap Türü Sil</h2>
			<hr />
		</div>

		<div class="mb-3">
			<label asp-for="CategoryName" class="p-0"></label>
			<input asp-for="CategoryName" disabled class="form-control"/>		
		</div>

		<button type="submit" class="btn btn-lg btn-danger" style="width:250px">Kitap Türü Sil</button>

		<a asp-controller="BookCategory" asp-action="Index" class="btn btn-lg btn-secondary" style="width:250px">
			Kitap Türlerine Geri Dön
		</a>

	</div>

</form>

